# Copy to backend/.env and adjust. Never commit .env.

# development | production | test
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API (no trailing slash).
# The Vite dev server runs on http://localhost:5173 by default.
CORS_ORIGINS=http://localhost:5173

# Maximum JSON request body size in bytes (image uploads will get their own limit).
JSON_BODY_LIMIT_BYTES=1000000

# Provider credentials will go here later (server-side only, never in frontend/.env):
# SEGMENTATION_PROVIDER=
# SEGMENTATION_API_KEY=
